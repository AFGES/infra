variant: flatcar
version: 1.1.0

passwd:
  users:
    - name: core
      ssh_authorized_keys: ${ssh_authorized_keys}

storage:
%{ if persistent_disk ~}
  disks:
    # Stable path: /dev/sdX order is not guaranteed and may land on the OS disk
    - device: /dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_drive-scsi1
      wipe_table: false
      partitions:
        - number: 1
          label: docker-data
          size_mib: 0
          start_mib: 0
  filesystems:
    - path: /var/lib/docker/volumes
      device: /dev/disk/by-partlabel/docker-data
      format: xfs
      wipe_filesystem: false
      with_mount_unit: true
      label: docker-data
%{~ endif }
  files:
    - path: /etc/vconsole.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          KEYMAP=fr
    # Let Docker bind ports to the vnet0 IP before the interface is configured
    # overwrite: Ignition reruns after a failed first boot and finds its own file
    - path: /etc/sysctl.d/99-afges-nonlocal-bind.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          net.ipv4.ip_nonlocal_bind = 1
%{ if length(kernel_modules) > 0 ~}
    - path: /etc/modules-load.d/flatcar-vm.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
%{ for module in kernel_modules ~}
          ${module}
%{ endfor ~}
%{ endif ~}
    - path: /etc/default/doco-cd
      mode: 0600
      contents:
        inline: |
          %{~ for k, v in doco_cd_env }
          ${k}=${v}
          %{~ endfor }

systemd:
  units:
    - name: docker.service
      enabled: true
    - name: doco-cd.service
      enabled: true
      contents: |
        [Unit]
        Description=Doco-CD Service
        Wants=network-online.target docker.service
        After=network-online.target docker.service

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/docker run --name doco-cd --rm --privileged \
          -v /var/run/docker.sock:/var/run/docker.sock \
          -v doco-cd.volume:/data \
          -e POLL_CONFIG="- url: https://github.com/AFGES/infra.git\n  target: %l\n  reference: main" \
          -e PASS_ENV=true \
          --env-file /etc/default/doco-cd \
          ghcr.io/kimdre/doco-cd:latest

        [Install]
        WantedBy=multi-user.target
