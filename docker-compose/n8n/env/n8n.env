N8N_HOST=n8n.afges.eu
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://n8n.afges.eu/
WEBHOOK_URL=https://n8n.afges.eu/
# Behind Pangolin (Traefik): trust one proxy hop for X-Forwarded-*
N8N_PROXY_HOPS=1
GENERIC_TIMEZONE=Europe/Paris
TZ=Europe/Paris
# N8N_DEFAULT_LOCALE=fr
N8N_SECURE_COOKIE=true
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
# AirGap mode: disable all external connections
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_WHATS_NEW_ENABLED=false
N8N_DYNAMIC_BANNERS_ENABLED=false
N8N_DISABLED_MODULES=mcp-registry
# Modules usable from the Code node
NODE_FUNCTION_ALLOW_EXTERNAL=uuid
# Database configuration
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgresql
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
